# Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Move .venv OUTSIDE of /app so volume mounts can't shadow it
ENV VIRTUAL_ENV=/opt/venv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv

# Install system dependencies including Node.js
RUN apt-get update && apt-get install -y \
    curl \
    procps \
    nodejs \
    npm \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY pyproject.toml uv.lock README.md ./

# Copy application code (quadlet may still volume-mount src/ for live updates)
COPY src/ ./src/
COPY modules/ ./modules/
COPY utils/ ./utils/

# Note: .roo/mcp.json will be available via volume mount at runtime
# Auto-discovery will find it from the mounted workspace or fall back to global config

# Install dependencies (uv sync creates a local virtualenv)
# Include memory extra for Mem0 integration (mem0ai, qdrant-client, etc.)
RUN pip install uv hatchling && uv sync --frozen --extra web --extra memory && ls -la /opt/venv || ls -la /app/.venv

RUN chmod -R 755 /opt/venv

# Expose the port
EXPOSE 8003

# Run the FastAPI proxy (inside uv-managed venv)
# Use HOST/PORT env vars so we can run multiple proxies side-by-side during migration.
# Use `exec` so uvicorn becomes PID 1 and receives SIGTERM properly under Podman/systemd.
CMD ["sh", "-c", "exec uv run --frozen --no-sync uvicorn src.main_fastapi:app --host \"${HOST:-0.0.0.0}\" --port \"${PORT:-8003}\""]
