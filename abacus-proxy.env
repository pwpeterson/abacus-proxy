################################################################################
# ABACUS-PROXY CONFIGURATION (loaded by the abacus-proxy service)
#
# Notes:
# - This file is intended to hold NON-SECRET defaults.
# - Secrets (API keys) should generally live in `.env` (not committed).
# - Some launchers may load *.env files AFTER `.env`. If you set a key here
#   (even blank), it can override `.env`. Keep secrets out of this file.
################################################################################

################################################################################
# SERVER CONFIGURATION
################################################################################

ROUTELLM_API_BASE_URL=https://routellm.abacus.ai/v1
ROUTELLM_MODEL_ID=route-llm

UPSTREAM_LOCAL_ADDRESS=0.0.0.0
UPSTREAM_TIMEOUT_SECONDS=120.0

# HTTP bind address for FastAPI (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# HTTP port for FastAPI
PORT=8003

# Model-proxy URL for MCP tools and internal references
MODEL_PROXY_URL=http://localhost:8003

################################################################################
# vLLM CONFIGURATION
################################################################################

# vLLM API endpoint (local instance)
VLLM_API_BASE_URL=http://localhost:8005/v1

# Model ID used by Roo Code to request vLLM
VLLM_MODEL_ID=route-vllm

# Actual model name served by vLLM (from --served-model-name)
VLLM_TARGET_MODEL=gemma-4-26b-a4b-it

################################################################################
# LOGGING CONFIGURATION
################################################################################

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Directory for logs and local artifacts
LOG_DIR=logs

# Log rotation and retention
LOG_ROTATION_SIZE=10 MB
LOG_RETENTION_DAYS=7
ERROR_LOG_RETENTION_DAYS=14

# Wire-level payload logging (redacted + truncated). Requires LOG_LEVEL=DEBUG for visibility.
# Summaries are generally sufficient; payload dumps are very noisy.
ENABLE_WIRE_LOGGING=true
WIRE_LOG_INCLUDE_PAYLOADS=false
WIRE_LOG_MAX_CHARS=8000
WIRE_LOG_MAX_LIST_ITEMS=50

# Legacy alias (kept for compatibility): must be "true" (not "yes") to enable.
# Prefer ENABLE_WIRE_LOGGING instead.
ENABLE_RAW_RESPONSE_LOGGING=false

# Performance logging (track slow requests and metrics)
ENABLE_PERFORMANCE_LOGGING=true

################################################################################
# MODEL ROUTING & ALIASING
################################################################################

# Default model alias target used when a client requests a "router" model
ROUTE_DEFAULT_TARGET_MODEL=gpt-5.2

# JSON-configurable alias mapping (optional)
# Example: MODEL_ALIASES_JSON='{"route-llm":"gpt-5.2","cheap-router":"gemini-3.1-flash"}'
MODEL_ALIASES_JSON=

# Enable intelligent model selection when model='route-llm'
ENABLE_INTELLIGENT_ROUTING=true

################################################################################
# MODEL VALUE INDEX (OPTIONAL)
################################################################################
#
# When enabled, you can request an enriched model catalog from `/v1/models` that
# includes per-use-case value indexes (coding/architecting/condensation) with:
# - minimum capability gates (e.g. condensation requires large context)
# - family quality priors multiplier (heuristic)
# - penalties for missing `thinking` and low `max_completion_tokens`
#
# This is intentionally OFF by default to avoid changing existing clients.
#
ENABLE_MODEL_VALUE_INDEX=false

# Exclude router models (like `route-llm`) from scoring
MODEL_VALUE_INDEX_EXCLUDE_ROUTER_MODELS=true

# Penalize models that do not specify `thinking` (0.0..0.8)
MODEL_VALUE_INDEX_MISSING_THINKING_PENALTY=0.10

# Optional JSON map of provider-family quality priors (float multipliers)
# Example:
# MODEL_VALUE_INDEX_FAMILY_PRIORS_JSON='{"openai":1.0,"anthropic":1.05,"meta":0.9}'
MODEL_VALUE_INDEX_FAMILY_PRIORS_JSON=

################################################################################
# MEM0 ("mem-zero") MEMORY LAYER
################################################################################

# Enable/disable memory features globally (retrieval + indexing utilities)
# Set to true to enable Mem0 integration for conversation memory and semantic search
ENABLE_MEMORY=true

# Vector store backend used by mem0 (qdrant recommended; chroma for local dev)
# Options: qdrant (production), chroma (local dev), or other mem0-supported stores
MEMORY_VECTOR_STORE=qdrant

# Local storage path used when MEMORY_VECTOR_STORE is a filesystem-backed store (or
# when Mem0 falls back to a local store).
MEMORY_VECTOR_STORE_PATH=./memory_data

# Embedding model used for memory + code indexing
MEMORY_EMBEDDING_MODEL=text-embedding-3-small

# Collection name for memories (Qdrant/Chroma)
# Use this to isolate per-project or per-environment memory without code changes.
MEMORY_COLLECTION_NAME=abacus_proxy_memory

################################################################################
# QDRANT CONFIGURATION (when MEMORY_VECTOR_STORE=qdrant)
################################################################################

# Qdrant server URL (required when MEMORY_VECTOR_STORE=qdrant)
# - Container networking: http://local-ai-qdrant:6333
# - Host access:          http://localhost:6333
# - Remote instance:      https://your-cluster.qdrant.io:6333
QDRANT_URL=http://localhost:6333

# Qdrant API key (optional; used for secured instances)
QDRANT_API_KEY=

################################################################################
# CONTEXT MANAGEMENT (conversation condensation)
################################################################################

# Server-side default/kill switch for context condensation.
# - true: allow condensation when threshold exceeded (unless request disables it)
# - false: disable condensation for all requests
ENABLE_CONTEXT_MANAGEMENT=true

# Trigger condensation when prompt tokens exceed this fraction of model context
# Range: 0.5-0.9 (lower = more aggressive condensation)
# NOTE: When ENABLE_DYNAMIC_THRESHOLD=true, this is the base threshold that gets
# adjusted based on request characteristics (50-75% range)
CONTEXT_THRESHOLD=0.8

# Keep this fraction of the most recent messages when condensing
# Increased from 0.3 to 0.5 to preserve more context
# NOTE: When ENABLE_IMPORTANCE_SCORING=true, messages are selected by importance
# score rather than just recency
KEEP_RECENT_RATIO=0.5

# Always keep at least N most recent messages
MIN_KEEP_MESSAGES=10

# When condensing, retrieve up to N relevant memories for the summary context
# Increased from 3 to 5 for better context retrieval
# NOTE: When ENABLE_ADAPTIVE_SUMMARY=true, this limit scales dynamically (2-8)
# based on available token budget
SUMMARY_LIMIT=5

################################################################################
# ENHANCED CONTEXT MANAGEMENT FEATURES
################################################################################

# Enable dynamic threshold adjustment based on request characteristics
# - Large context (>30k chars): 50% threshold (condensation use case)
# - Coding with tools: 60% threshold (needs response buffer)
# - Architecture/planning: 75% threshold (can use more context)
# - Default: uses CONTEXT_THRESHOLD value
ENABLE_DYNAMIC_THRESHOLD=true

# Enable message importance scoring for smarter retention
# Prioritizes keeping:
# - Tool calls/results (2.5x importance)
# - Errors/warnings (1.8x importance)
# - Code blocks (1.4x importance)
# - User questions (1.3x importance)
# - Recent messages (exponential decay bonus)
ENABLE_IMPORTANCE_SCORING=true

# Enable system message compression to prevent bloat
# - Deduplicates identical system messages by content hash
# - Limits system messages to 30% of context budget
# - Prevents unbounded growth from rules/code injection
ENABLE_SYSTEM_COMPRESSION=true

# Enable adaptive summary retrieval based on available budget
# Scales Mem0 retrieval dynamically:
# - >50% tokens saved: 8 items
# - >30% tokens saved: 5 items
# - >15% tokens saved: 4 items
# - Tight budget: 2-3 items (uses SUMMARY_LIMIT)
ENABLE_ADAPTIVE_SUMMARY=true

################################################################################
# ADVANCED COMPRESSION STRATEGIES
################################################################################

# Enable code block compression before storing to Mem0
# Summarizes large code blocks (>=20 lines) to reduce token overhead
# Expected savings: 2-5K tokens per condensation
# Example: 100-line code block → 10-line summary with "... [90 lines omitted] ..."
ENABLE_CODE_COMPRESSION=true

# Minimum code block lines to trigger compression (5-500)
# Only code blocks with >= this many lines will be compressed
CODE_COMPRESSION_MIN_LINES=20

# Enable differential compression for similar consecutive messages
# Stores diffs instead of full messages for similar content (>=85% similarity)
# Expected savings: 1-3K tokens per condensation
# Example: Two 500-char messages with 90% similarity → first full + 50-char diff
ENABLE_DIFFERENTIAL_COMPRESSION=true

# Similarity threshold for differential compression (0.5-0.99)
# Messages with similarity >= this threshold will be diff-compressed
# Lower values = more aggressive compression, higher values = more selective
DIFFERENTIAL_SIMILARITY_THRESHOLD=0.85

# Enable aggressive system message section deduplication
# Hash system message sections separately (Roo rules, MCP servers, tools)
# instead of entire messages for better deduplication
# Expected savings: 2-5K tokens per condensation
# Example: Identical "MCP server: conport" blocks across messages → deduplicated
ENABLE_AGGRESSIVE_SYSTEM_DEDUP=true

################################################################################
# PROMPT GUARD (abacus-proxy upstream preflight trimming)
################################################################################
#
# Prevent upstream "input exceeds context window" errors by trimming oversized
# chat histories before proxying.
#
# Notes:
# - These are heuristic character budgets (not token counts).
# - Keep these in this NON-SECRET env file; override per-host in `.env` as needed.
# - INCREASED LIMITS: Previous values were too restrictive and truncated large
#   system prompts (Roo's rules + MCP server definitions), causing incomplete
#   information to reach external LLMs.
#
PROMPT_GUARD_ENABLED=true
# Increased from 80000 to 200000 to accommodate large system prompts
PROMPT_MAX_INPUT_CHARS=80000
# Increased from 20000 to 150000 to prevent truncating system messages
PROMPT_MAX_SINGLE_MESSAGE_CHARS=150000
# Increased from 30 to 50 to keep more conversation history
PROMPT_KEEP_LAST_MESSAGES=10
PROMPT_PRESERVE_SYSTEM_MESSAGES=true

################################################################################
# INTELLIGENT TOOL SELECTION
################################################################################
#
# Reduces token overhead by intelligently selecting only relevant tools:
# - Always includes "core" tools (Roo Code built-ins + essential MCP tools)
# - Selects additional tools based on:
#   * Request content (keyword/semantic analysis)
#   * Recent tool usage from conversation history
#   * Mem0 patterns (if INTELLIGENT_TOOL_USE_MEM0=true)
#
# Expected savings: ~30-50K tokens per request (247 tools → 25-45 tools)
#
ENABLE_INTELLIGENT_TOOL_SELECTION=true

# Use Mem0 to suggest tools based on historical usage patterns
INTELLIGENT_TOOL_USE_MEM0=true

# Minimum keyword matches to include a tool category (1-5)
INTELLIGENT_TOOL_MIN_KEYWORD_MATCHES=1

# Number of recent messages to analyze for tool usage patterns (3-50)
INTELLIGENT_TOOL_RECENT_USAGE_WINDOW=10

# Core tools that are ALWAYS included (comma-separated list)
# These are Roo Code built-in tools + essential MCP tools for basic operations.
#
# ROO CODE BUILT-IN TOOLS (always available - 29 tools):
#   File Operations (9):
#     - read_file, write_to_file, list_files, search_files
#     - apply_diff, edit, edit_file, apply_patch, search_replace
#   
#   Command Execution (2):
#     - execute_command, read_command_output
#   
#   Mode & Task Management (3):
#     - switch_mode, new_task, update_todo_list
#   
#   Communication (2):
#     - ask_followup_question, attempt_completion
#   
#   Development Tools (4):
#     - browser_action, codebase_search, generate_image, run_slash_command
#   
#   MCP Integration (2):
#     - access_mcp_resource, use_mcp_tool
#   
#   Information (1):
#     - fetch_instructions
#
# ESSENTIAL MCP TOOLS (project context - 5 tools):
#   ConPort Read Operations:
#     - get_product_context, get_active_context, get_decisions
#     - search_decisions_fts, get_recent_activity_summary
#
# TOTAL: 34 core tools always included
#
# Customize this list based on your workflow needs. Tool names should match
# exactly (case-sensitive), without the mcp_ prefix.
#
CORE_TOOL_NAMES=read_file,write_to_file,list_files,search_files,apply_diff,edit,edit_file,apply_patch,search_replace,attempt_completion,ask_followup_question,execute_command,read_command_output,browser_action,codebase_search,generate_image,switch_mode,new_task,update_todo_list,run_slash_command,access_mcp_resource,use_mcp_tool,fetch_instructions,get_product_context,get_active_context,get_decisions,search_decisions_fts,get_recent_activity_summary

################################################################################
# LEGACY MCP TOOL INCLUSION (deprecated - use INTELLIGENT_TOOL_SELECTION)
################################################################################
#
# NOTE: These settings are superseded by ENABLE_INTELLIGENT_TOOL_SELECTION.
# Kept for backward compatibility only.
#
# Available categories:
#   - core: filesystem, execute_command (essential file/command operations)
#   - version_control: mcp-git-tools, git-safe (git operations)
#   - memory: conport, mem0-mcp, mindscape-ai (project memory/context)
#   - code_quality: mcp-toolbox (code analysis, quality tools)
#   - web: brave-search, fetch-mcp, puppeteer, chrome-devtools, browser-tools-mcp
#   - documentation: context7, mcp-crawl4ai-rag (docs retrieval)
#   - data: sqlite (database operations)
#

# Enable MCP tool inclusion filtering for non-vLLM models (deprecated)
ENABLE_TOOL_INCLUSION=false

# Include specific categories (deprecated - use intelligent tool selection)
TOOL_INCLUDE_CATEGORIES=

# Include specific server names (deprecated - use intelligent tool selection)
TOOL_FILTER_SERVERS=

################################################################################
# ROO RULES (Mem0-backed) - OPTIONAL
################################################################################

# Enable Mem0-backed `.roo` rules retrieval and injection.
# Requires indexing rules first via the endpoint/CLI or auto-indexing.
ENABLE_RULES_MEMORY=true

# Mem0 namespace used to store/retrieve `.roo` rule shards
RULES_MEMORY_USER_ID=system
RULES_MEMORY_PROJECT_ID=roo_rules

# Retrieval limits (keep small to avoid prompt bloat)
RULES_MEMORY_MAX_SHARDS=8
RULES_MEMORY_MAX_TOKENS=900

# Skip rule retrieval for trivial short queries (e.g. "2+2")
RULES_MEMORY_TRIVIAL_BYPASS=true

# AUTO-INDEXING: Automatically index .roo/rules on startup
# When enabled, rules are indexed into mem0 when the application starts.
# This eliminates the need for manual indexing via API/CLI.
AUTO_INDEX_RULES_ON_STARTUP=true

# Minimum hours between re-indexing operations (prevents excessive indexing)
AUTO_INDEX_INTERVAL_HOURS=24

# Optional writable directory for auto-index state marker (defaults to /tmp or CWD fallback)
AUTO_INDEX_STATE_DIR=

# Indexing parameters (optional, defaults shown)
AUTO_INDEX_MAX_CHARS=1200
AUTO_INDEX_OVERLAP_CHARS=150

################################################################################
# CODEBASE JIT CONTEXT (semantic code retrieval) - OPTIONAL
################################################################################

# Enable per-request semantic code retrieval + injection into system prompt.
# Requires indexing the codebase first.
ENABLE_CODE_JIT_CONTEXT=true

# Max number of code chunks to inject
CODE_JIT_MAX_CHUNKS=6

# Approx token budget for injected code chunks
CODE_JIT_MAX_TOKENS=2000

# Skip code JIT retrieval for trivial short queries
CODE_JIT_TRIVIAL_BYPASS=true

################################################################################
# ABACUS-PROXY REQUEST TRACKING (SUPABASE)
################################################################################

# Enable request tracking for intelligent routing analysis
# When enabled, logs requests to Supabase for analyzing routing effectiveness,
# context condensation, and cost optimization
ENABLE_REQUEST_TRACKING=true

# Supabase project URL (required when ENABLE_REQUEST_TRACKING=true)
# Example: https://your-project.supabase.co
# NOTE: Also set in /etc/containers/systemd/.env
SUPABASE_URL=http://localhost:8100

# Supabase service role key (required when ENABLE_REQUEST_TRACKING=true)
# This is the service_role key from your Supabase project settings
# IMPORTANT: Keep this secret! Set in .env, not here.
#
# Supported env var names (checked in order):
#   1. SUPABASE_SERVICE_ROLE_KEY (this variable)
#   2. SERVICE_ROLE_KEY (Supabase standard) ← Used from .env
#   3. SUPABASE_SERVICE_KEY (Supabase self-hosted standard) ← Used from .env
#   4. SUPABASE_KEY (legacy)
#
# For self-hosted Supabase, SUPABASE_SERVICE_KEY is already set in .env
# NOTE: Do NOT set SUPABASE_SERVICE_ROLE_KEY here - it will override .env
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3NjY4MDUzMTUsImV4cCI6MjA4MjE2NTMxNX0.T9wjzXlwpML-6BuvWHFE9kfXbbomWsUu7aOIPRoSk4c

# Privacy controls: what data to store (all default to false for privacy)
# Only enable if you need detailed debugging and understand the privacy implications
STORE_REQUEST_PAYLOADS=true
STORE_RESPONSE_PAYLOADS=true
STORE_CONTEXT_TEXT=true

# Request tracking timeout (best-effort, never blocks requests)
REQUEST_TRACKING_TIMEOUT_SECONDS=2.5

################################################################################
# MCP SERVER CONFIGURATION
################################################################################

# Enable MCP WebSocket server alongside FastAPI
ENABLE_MCP=true

# MCP WebSocket bind address/port
MCP_HOST=0.0.0.0
MCP_PORT=9002

# Enable MCP debug mode
MCP_DEBUG=false

# MCP maximum message size in bytes (default 10MB)
MCP_MAX_MESSAGE_SIZE=10485760

# MCP keepalive settings
MCP_PING_INTERVAL=20
MCP_PING_TIMEOUT=60
MCP_CLOSE_TIMEOUT=10

################################################################################
# PYTHON PATH
################################################################################

# Add src directory to Python path for imports
PYTHONPATH=src
