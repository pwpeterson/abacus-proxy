            # DEBUG: Log upstream response
            logger.info(f"[DEBUG] Upstream response status: {r.status_code}")
            try:
                upstream_data = r.json()
                
                # Log response structure
                choices = upstream_data.get("choices", [])
                if choices:
                    first_choice = choices[0]
                    message = first_choice.get("message", {})
                    
                    logger.info(
                        f"[DEBUG] Upstream response: "
                        f"has_content={message.get('content') is not None}, "
                        f"has_tool_calls={message.get('tool_calls') is not None}"
                    )
                    
                    # If tool calls exist, log them
                    tool_calls = message.get("tool_calls")
                    if tool_calls:
                        logger.info(f"[DEBUG] Upstream returned {len(tool_calls)} tool calls")
                        for i, tc in enumerate(tool_calls[:3]):  # Log first 3
                            func = tc.get("function", {})
                            logger.info(
                                f"[DEBUG] Tool call {i}: "
                                f"name={func.get('name')}, "
                                f"args_preview={func.get('arguments', '')[:100]}"
                            )
                    
                    # Log full first tool call for inspection
                    if tool_calls:
                        logger.info(f"[DEBUG] First tool call full: {json.dumps(tool_calls[0], indent=2)}")
                
                # Store for later comparison
                original_upstream_data = upstream_data.copy()
                
            except Exception as e:
                logger.error(f"[DEBUG] Failed to parse upstream response: {e}")

