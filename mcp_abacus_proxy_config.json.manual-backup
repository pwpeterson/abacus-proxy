{
  "mcp_bridge": {
    "enabled": true,
    "server_allowlist": [
      "filesystem",
      "conport",
      "mem0-mcp",
      "mcp-git-tools",
      "brave-search",
      "fetch-mcp",
      "puppeteer",
      "sqlite",
      "mcp-toolbox",
      "mcp-crawl4ai-rag"
    ],
    "defaults": {
      "enabled": true,
      "timeout_ms": 30000,
      "connect_timeout_ms": 5000,
      "max_concurrent": 5,
      "deny_by_default": false,
      "allowed_tools": [
        "*"
      ],
      "denied_tools": [],
      "allowed_transports": [
        "sse",
        "stdio"
      ]
    },
    "servers": {
      "mcp-toolbox": {
        "enabled": true,
        "max_concurrent": 5,
        "timeout_ms": 60000
      },
      "mcp-crawl4ai-rag": {
        "enabled": true,
        "max_concurrent": 3,
        "timeout_ms": 60000
      }
    },
    "schema_validation": {
      "enabled": true,
      "source_precedence": [
        "live_tools_list_cache",
        "registry_if_unambiguous"
      ],
      "live_cache_ttl_seconds": 300
    },
    "hygiene": {
      "enabled": true,
      "max_output_chars": 20000
    },
    "audit": {
      "enabled": true,
      "log_arguments": true,
      "redact_keys": [
        "password",
        "token",
        "key",
        "secret",
        "api_key",
        "apikey"
      ],
      "max_arg_chars": 2000
    }
  },
  "filesystem": {
    "type": "sse",
    "url": "http://localhost:3000/sse",
    "description": "Filesystem operations MCP server"
  },
  "conport": {
    "type": "sse",
    "url": "http://localhost:3001/sse",
    "description": "ConPort context management server"
  },
  "mem0-mcp": {
    "type": "sse",
    "url": "http://localhost:3002/sse",
    "description": "Mem0 memory management server"
  },
  "mcp-git-tools": {
    "type": "sse",
    "url": "http://localhost:3003/sse",
    "description": "Git operations MCP server"
  },
  "brave-search": {
    "type": "sse",
    "url": "http://localhost:3004/sse",
    "description": "Brave search API server"
  },
  "fetch-mcp": {
    "type": "sse",
    "url": "http://localhost:3005/sse",
    "description": "HTTP fetch MCP server"
  },
  "puppeteer": {
    "type": "sse",
    "url": "http://localhost:3006/sse",
    "description": "Puppeteer browser automation server"
  },
  "sqlite": {
    "type": "sse",
    "url": "http://localhost:3007/sse",
    "description": "SQLite database operations server"
  },
  "mcp-toolbox": {
    "type": "sse",
    "url": "http://localhost:8004/sse",
    "description": "Comprehensive MCP tool inventory with 69 development tools"
  },
  "mcp-crawl4ai-rag": {
    "type": "sse",
    "url": "http://localhost:8051/sse",
    "description": "Web crawling and RAG indexing service"
  }
}