# Abacus Proxy Configuration Example
# Copy this file to abacus-proxy.env and customize for your deployment

# ============================================================================
# HTTP Server
# ============================================================================
HOST=0.0.0.0
PORT=8003

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Upstream APIs
# ============================================================================
# RouteLLM/Abacus API
ROUTELLM_API_BASE_URL=https://routellm.abacus.ai/v1
ABACUS_API_KEY=your_api_key_here

# vLLM API (local instance)
VLLM_API_BASE_URL=http://localhost:8005/v1
VLLM_MODEL_ID=route-vllm
VLLM_TARGET_MODEL=gemma-4-26b-a4b-it

# ============================================================================
# MCP Tool Inclusion (System Prompt Optimization)
# ============================================================================
# Enable tool inclusion for non-vLLM models to reduce token usage
# This works as an ALLOWLIST - only the servers/categories you specify are INCLUDED
ENABLE_TOOL_INCLUSION=false

# Method 1: Include by categories (recommended)
# Available categories: core, version_control, memory, code_quality, web, documentation, data
# Example: Include only essential tools
TOOL_INCLUDE_CATEGORIES='["core","memory","version_control"]'

# Method 2: Include by explicit server names (advanced)
# Example: Include only specific servers
# TOOL_INCLUDE_SERVERS='["filesystem","conport","mcp-git-tools"]'

# Note: If both are set, TOOL_INCLUDE_SERVERS takes precedence

# Category breakdown:
# - core: filesystem, execute_command (essential file/command operations)
# - version_control: mcp-git-tools, git-safe (git operations)
# - memory: conport, mem0-mcp, mindscape-ai (project memory/context)
# - code_quality: mcp-toolbox (code analysis, quality tools)
# - web: brave-search, fetch-mcp, puppeteer, chrome-devtools, browser-tools-mcp
# - documentation: context7, mcp-crawl4ai-rag (docs retrieval)
# - data: sqlite (database operations)

# ============================================================================
# Examples
# ============================================================================

# Example 1: Minimal setup (include core + memory only) - ~60% token reduction
# ENABLE_TOOL_INCLUSION=true
# TOOL_INCLUDE_CATEGORIES='["core","memory"]'

# Example 2: Code-focused (include core + memory + version_control + code_quality) - ~40% reduction
# ENABLE_TOOL_INCLUSION=true
# TOOL_INCLUDE_CATEGORIES='["core","memory","version_control","code_quality"]'

# Example 3: Web development (include core + memory + web + documentation) - ~50% reduction
# ENABLE_TOOL_INCLUSION=true
# TOOL_INCLUDE_CATEGORIES='["core","memory","web","documentation"]'

# Example 4: Explicit servers (advanced)
# ENABLE_TOOL_INCLUSION=true
# TOOL_INCLUDE_SERVERS='["filesystem","conport","mcp-git-tools","brave-search"]'

# ============================================================================
# Intelligent Model Routing
# ============================================================================
ENABLE_INTELLIGENT_ROUTING=true
ROUTE_DEFAULT_TARGET_MODEL=gpt-5.2

# ============================================================================
# Prompt Guard (Context Window Protection)
# ============================================================================
PROMPT_GUARD_ENABLED=true
PROMPT_MAX_INPUT_CHARS=200000
PROMPT_MAX_SINGLE_MESSAGE_CHARS=50000
PROMPT_KEEP_LAST_MESSAGES=80

# ============================================================================
# Mem0 Context Management
# ============================================================================
ENABLE_MEMORY=true
ENABLE_CONTEXT_MANAGEMENT=true
MEMORY_VECTOR_STORE=qdrant
MEMORY_VECTOR_STORE_PATH=./memory_data

# Optional centralized Qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ============================================================================
# Request Tracking (Supabase)
# ============================================================================
ENABLE_REQUEST_TRACKING=false
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

STORE_REQUEST_PAYLOADS=false
STORE_RESPONSE_PAYLOADS=false
